# Öffentliche URL der Seite (für Metadaten und OG-Bild)
NEXT_PUBLIC_SITE_URL=https://classivo.de

# Geheimnis zum Signieren des Schritt-2-Tokens (in Produktion Pflicht).
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SIGNUP_SECRET=

# Supabase – Anmeldungen landen in public.beta_sign_ups.
# Ohne diese beiden Werte werden Anmeldungen lokal in .data/*.jsonl geschrieben (nur in der Entwicklung).
SUPABASE_URL=https://qffnjjmsjsamtdfufujf.supabase.co
# Secret Key (sb_secret_…) aus Dashboard → Project Settings → API Keys.
# NUR serverseitig verwenden, niemals mit NEXT_PUBLIC_ prefixen oder committen.
SUPABASE_SECRET_KEY=
